{
  "id": "git-workbench",
  "name": "Git 工作台",
  "version": "0.2.7",
  "sdkVersion": "^0.3.23",
  "author": "ccgui",
  "description": "复刻 IntelliJ IDEA 的 Git 工具窗口：多仓库识别、本地更改 / 提交、提交图、分支、合并/变基、暂存、标签、远程、子模块、Blame、控制台。直接驱动本机 git CLI，兼容任意 git 版本与任意托管平台。",
  "tier": "js",
  "permissions": [
    "storage",
    "plugin.storage",
    "theme",
    "workspace.metadata.read",
    "host:workspace",
    "ui:panel-tab",
    "ui:settings-section",
    "ui:sidebar-entry",
    "ui:overlay",
    "ui:command",
    "ui:workspace-menu",
    "ui:file-link-menu",
    "exec:git",
    "exec:sh",
    "exec:powershell",
    "network:none"
  ]
}
